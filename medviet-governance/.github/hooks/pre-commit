#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

PYTHON_BIN="python"
if [[ -x ".venv/Scripts/python.exe" ]]; then
  PYTHON_BIN=".venv/Scripts/python.exe"
elif [[ -x ".venv/bin/python" ]]; then
  PYTHON_BIN=".venv/bin/python"
fi

GIT_SECRETS_BIN="${GIT_SECRETS_PATH:-$HOME/.git-secrets/git-secrets}"
if [[ -x "$GIT_SECRETS_BIN" ]]; then
  "$GIT_SECRETS_BIN" --pre_commit_hook --
else
  echo "git-secrets executable not found; skipping secret hook." >&2
fi

"$PYTHON_BIN" -m bandit -r src/ -ll -q
"$PYTHON_BIN" -m pip_audit --desc on
